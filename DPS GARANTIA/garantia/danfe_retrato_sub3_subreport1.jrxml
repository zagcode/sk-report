<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="danfe_retrato_sub3_subreport1" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PK_ID" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[WITH TABGAR AS (


    SELECT
        RITE.NUNOTA,
        TGFCAB.NUMNOTA AS NUMNOTACAB,
        TGAR.ID,
        TGAR.TIPO,
        CASE WHEN RITE.QTDNEG IS NULL THEN '1' ELSE RITE.QTDNEG END QTDNEG,
        RITE.ID AS ID_RITE,
        RITE.SEQUENCIA AS SEQUENCIA_RITE,
        RITE.CODPROD,
        ITE.VLRUNIT,
        RITE.VLRUNIT AS VLRUNIT_RITE,
        TGAR.CODPARC




FROM AD_TJKCERGARITE RITE
    INNER JOIN AD_TJKCETGAR TGAR
        ON TGAR.ID = RITE.ID
    INNER JOIN TGFCAB
        ON TGFCAB.NUNOTA = RITE.NUNOTA
    INNER JOIN TGFPAR PAR ON PAR.CODPARC = TGAR.CODPARC
    INNER JOIN TSIEND ENDE ON PAR.CODEND = ENDE.CODEND
    INNER JOIN TSIBAI BAI ON PAR.CODBAI = BAI.CODBAI
    INNER JOIN TSICID CID ON PAR.CODCID = CID.CODCID
    LEFT JOIN TGFITE ITE ON ITE.NUNOTA = RITE.NUNOTA AND ITE.CODPROD = RITE.CODPROD

    WHERE
 TGAR.ID IN ($P{PK_ID})


),

TABVAR AS (


SELECT
DISTINCT
    ITE.SEQUENCIA,
    ITE.CODPROD,
    ITE.NUNOTA,

    ITE.VLRSUBST,
    ITE.VLRICMS,

    (ITE.VLRICMS / ITE.QTDNEG) AS VLRICMS_UNIT,

    ITE.VLRSUBSTANT,

    (ITE.VLRSUBST / ITE.QTDNEG) AS VLRSUBST_UNIT,

    ITE.BASEICMS,

    (ITE.BASEICMS / ITE.QTDNEG) AS BASEICMS_UNIT,

    (ITE.VLRUNIT - ITE.VLRDESC) AS VLR_LIQ,

    ITE.BASESUBSTITANT,
    ITE.BASESUBSTIT,


    CASE
	   WHEN (FEMP.VLRLIQITEMNFE IS NOT NULL AND FEMP.VLRLIQITEMNFE='S') THEN (ITE.VLRTOT - ITE.VLRDESC - ITE.VLRREPRED)
	   ELSE  ITE.VLRTOT
	END AS VLRTOT,
	CASE
	   WHEN (FEMP.VLRLIQITEMNFE IS NOT NULL AND FEMP.VLRLIQITEMNFE='S') THEN 0
	   ELSE  ITE.PERCDESC
	END AS PERCDESC,
	CASE
	   WHEN (FEMP.VLRLIQITEMNFE IS NOT NULL AND FEMP.VLRLIQITEMNFE='S') THEN 0
	   ELSE  ITE.VLRDESC + ITE.VLRREPRED
	END AS VLRDESC,
	CASE
	   WHEN (FEMP.VLRLIQITEMNFE IS NOT NULL AND FEMP.VLRLIQITEMNFE='S') THEN (ITE.VLRUNIT - (ITE.VLRDESC/ITE.QTDNEG) - (ITE.VLRREPRED/ITE.QTDNEG))
	   ELSE  ITE.VLRUNIT
	END AS VLRUNIT,
	CASE
  	  WHEN (RTRIM(PRO.NCM) IS NOT NULL ) THEN PRO.NCM
	  ELSE IPI.CODFISIPI
	END AS 	CODFISIPI


FROM TGFITE ITE
INNER JOIN TGFCAB CAB  ON (CAB.NUNOTA = ITE.NUNOTA)
INNER JOIN TGFEMP FEMP ON (CAB.CODEMP = FEMP.CODEMP)
INNER JOIN TSIEMP EMP ON (EMP.CODEMP = CAB.CODEMP)
INNER JOIN TGFPRO PRO ON (ITE.CODPROD = PRO.CODPROD)
LEFT JOIN TGFIPI IPI ON (IPI.CODIPI = PRO.CODIPI)
LEFT JOIN TGFCFO CFO ON (CFO.CODCFO = ITE.CODCFO),
TGFLOC LOC
WHERE ITE.NUNOTA IN (
        SELECT DISTINCT RITE.NUNOTA
        FROM AD_TJKCERGARITE RITE
        WHERE RITE.ID = $P{PK_ID} AND RITE.ID IS NOT NULL
    )
    AND ITE.CODPROD IN (
        SELECT RITE.CODPROD
        FROM AD_TJKCERGARITE RITE
        WHERE RITE.ID = $P{PK_ID} AND RITE.ID IS NOT NULL
    )





AND ITE.SEQUENCIA > 0
AND ITE.CODLOCALORIG = LOC.CODLOCAL
AND (

	(ITE.USOPROD <> 'D' ) OR
	( NOT EXISTS (
						SELECT 1
						FROM TGFVAR VAR
						WHERE
							VAR.NUNOTA = ITE.NUNOTA AND
							VAR.NUNOTAORIG = ITE.NUNOTA AND
							VAR.SEQUENCIAORIG = ITE.SEQUENCIA))
    )




),

TABCALC AS (

SELECT

    SUM(TABGAR.VLRUNIT_RITE) AS VALOR,

    CASE WHEN TABGAR.TIPO = 'D' THEN SUM(TABVAR.BASEICMS_UNIT) * TABGAR.QTDNEG  ELSE SUM(TABVAR.BASEICMS_UNIT) END BASEICMS_UNIT,

    CASE WHEN TABGAR.TIPO = 'D' THEN SUM(TABVAR.VLRICMS_UNIT) * TABGAR.QTDNEG ELSE SUM(TABVAR.VLRICMS_UNIT) END VLRICMS_UNIT,

    CASE WHEN TABGAR.TIPO = 'D' THEN SUM(TABVAR.VLRSUBST_UNIT) * TABGAR.QTDNEG ELSE SUM(TABVAR.VLRSUBST_UNIT) END VLRSUBST_UNIT,

    CASE WHEN TABGAR.TIPO = 'D' THEN SUM(TABVAR.VLRUNIT) * TABGAR.QTDNEG ELSE SUM(TABVAR.VLRUNIT) END VLRUNIT_PROD,

    SUM(TABVAR.VLRDESC) AS VLR_DESC,
    SUM(TABVAR.VLR_LIQ) AS VLR_LIQ,
    SUM(TABVAR.VLRUNIT) + SUM(TABVAR.VLRSUBST_UNIT) AS VALOR_NOTA,
    SUM(TABVAR.VLR_LIQ) + SUM(TABVAR.VLRSUBST_UNIT) AS VALOR_NOTA_LIQ,
    SUM(TABVAR.BASEICMS_UNIT) + SUM(TABVAR.VLRSUBST_UNIT) AS VALOR_NOTA_LIQ2


/*IMPOSTOS*/
/*
   TABVAR.BASEICMS,
	TABVAR.VLRICMS,
	TABVAR.BASESUBSTIT,
	TABVAR.VLRSUBST
*/

FROM TABGAR
LEFT JOIN TABVAR ON TABVAR.CODPROD = TABGAR.CODPROD AND TABGAR.NUNOTA = TABVAR.NUNOTA



WHERE
 TABGAR.ID_RITE IN ($P{PK_ID})

GROUP BY
TABGAR.TIPO,
TABGAR.QTDNEG

),

TABVALORPROD AS (

SELECT
	SUM(
		CASE
			WHEN TABGAR.TIPO = 'D' THEN ISNULL(TABGAR.VLRUNIT_RITE, 0) * ISNULL(TRY_CONVERT(DECIMAL(18, 6), TABGAR.QTDNEG), 1)
			ELSE ISNULL(TABGAR.VLRUNIT_RITE, 0)
		END
	) AS VLRUNIT_PROD
FROM TABGAR
WHERE TABGAR.ID IN ($P{PK_ID})

)

SELECT

    SUM(TABCALC.BASEICMS_UNIT) AS BASEICMS_UNIT,
    SUM(TABCALC.VLRICMS_UNIT) AS VLRICMS_UNIT,
    SUM(TABCALC.VLRSUBST_UNIT) AS VLRSUBST_UNIT,
	MAX(TABVALORPROD.VLRUNIT_PROD) AS VLRUNIT_PROD,
	MAX(TABVALORPROD.VLRUNIT_PROD) + SUM(TABCALC.VLRSUBST_UNIT) AS VALOR_LIQ,
    SUM(VALOR_NOTA_LIQ2) AS VALOR_NOTA_LIQ2


FROM
TABCALC
CROSS JOIN TABVALORPROD]]>
	</queryString>
	<field name="BASEICMS_UNIT" class="java.lang.Double"/>
	<field name="VLRICMS_UNIT" class="java.lang.Double"/>
	<field name="VLRSUBST_UNIT" class="java.lang.Double"/>
	<field name="VLRUNIT_PROD" class="java.lang.Double"/>
	<field name="VALOR_LIQ" class="java.lang.Double"/>
	<field name="VALOR_NOTA_LIQ2" class="java.lang.Double"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<columnHeader>
		<band height="40" splitType="Stretch">
			<textField pattern="¤ #,##0.00">
				<reportElement x="3" y="24" width="101" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{BASEICMS_UNIT}]]></textFieldExpression>
			</textField>
			<textField pattern="¤ #,##0.00">
				<reportElement x="107" y="24" width="101" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{VLRICMS_UNIT}]]></textFieldExpression>
			</textField>
			<textField pattern="¤ #,##0.00">
				<reportElement x="211" y="24" width="100" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{VLRSUBST_UNIT}]]></textFieldExpression>
			</textField>
			<rectangle radius="3">
				<reportElement key="rectangle-28" mode="Transparent" x="3" y="13" width="101" height="25"/>
			</rectangle>
			<staticText>
				<reportElement x="4" y="14" width="100" height="12"/>
				<textElement verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<text><![CDATA[BASE ICMS]]></text>
			</staticText>
			<staticText>
				<reportElement x="4" y="1" width="159" height="10"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Courier New" size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[TOTALIZADOR]]></text>
			</staticText>
			<rectangle radius="3">
				<reportElement key="rectangle-28" mode="Transparent" x="105" y="13" width="103" height="25"/>
			</rectangle>
			<rectangle radius="3">
				<reportElement key="rectangle-28" mode="Transparent" x="208" y="13" width="103" height="25"/>
			</rectangle>
			<rectangle radius="3">
				<reportElement key="rectangle-28" mode="Transparent" x="312" y="13" width="103" height="25"/>
			</rectangle>
			<staticText>
				<reportElement x="108" y="14" width="100" height="12"/>
				<textElement verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<text><![CDATA[VALOR DO ICMS]]></text>
			</staticText>
			<staticText>
				<reportElement x="211" y="14" width="100" height="12"/>
				<textElement verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<text><![CDATA[DESPESAS ACESSÓRIAS]]></text>
			</staticText>
			<textField pattern="¤ #,##0.00">
				<reportElement x="315" y="24" width="100" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{VLRUNIT_PROD}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="315" y="14" width="100" height="12"/>
				<textElement verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<text><![CDATA[VALOR PRODUTO]]></text>
			</staticText>
			<staticText>
				<reportElement x="419" y="14" width="100" height="12"/>
				<textElement verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<text><![CDATA[VALOR TOTAL]]></text>
			</staticText>
			<rectangle radius="3">
				<reportElement key="rectangle-28" mode="Transparent" x="416" y="13" width="103" height="25"/>
			</rectangle>
			<textField pattern="¤ #,##0.00">
				<reportElement x="419" y="24" width="100" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
