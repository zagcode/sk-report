<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="danfe_retrato_sub3_subreport2" language="groovy" pageWidth="300" pageHeight="802" columnWidth="300" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="4.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PK_ID" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[WITH TABGAR AS (


    SELECT
        RITE.NUNOTA,
        TGFCAB.NUMNOTA AS NUMNOTACAB,
        TGAR.ID,
        TGAR.TIPO,
        CASE WHEN RITE.QTDNEG IS NULL THEN '1' ELSE RITE.QTDNEG END QTDNEG,
        RITE.ID AS ID_RITE,
        RITE.SEQUENCIA AS SEQUENCIA_RITE,
        RITE.CODPROD,
        ITE.VLRUNIT,
        RITE.VLRUNIT AS VLRUNIT_RITE,
        TGAR.CODPARC




FROM AD_TJKCERGARITE RITE
    INNER JOIN AD_TJKCETGAR TGAR
        ON TGAR.ID = RITE.ID
    INNER JOIN TGFCAB
        ON TGFCAB.NUNOTA = RITE.NUNOTA
    INNER JOIN TGFPAR PAR ON PAR.CODPARC = TGAR.CODPARC
    INNER JOIN TSIEND ENDE ON PAR.CODEND = ENDE.CODEND
    INNER JOIN TSIBAI BAI ON PAR.CODBAI = BAI.CODBAI
    INNER JOIN TSICID CID ON PAR.CODCID = CID.CODCID
    LEFT JOIN TGFITE ITE ON ITE.NUNOTA = RITE.NUNOTA AND ITE.CODPROD = RITE.CODPROD

    WHERE
 TGAR.ID IN ($P{PK_ID})


),

TABVAR AS (


SELECT
DISTINCT
    ITE.SEQUENCIA,
    ITE.CODPROD,
    ITE.NUNOTA,

    ITE.VLRSUBST,
    ITE.VLRICMS,

    (ITE.VLRICMS / ITE.QTDNEG) AS VLRICMS_UNIT,

    ITE.VLRSUBSTANT,

    (ITE.VLRSUBST / ITE.QTDNEG) AS VLRSUBST_UNIT,

    ITE.BASEICMS,

    (ITE.BASEICMS / ITE.QTDNEG) AS BASEICMS_UNIT,

    (ITE.VLRUNIT - ITE.VLRDESC) AS VLR_LIQ,

    ITE.BASESUBSTITANT,
    ITE.BASESUBSTIT,


    CASE
	   WHEN (FEMP.VLRLIQITEMNFE IS NOT NULL AND FEMP.VLRLIQITEMNFE='S') THEN (ITE.VLRTOT - ITE.VLRDESC - ITE.VLRREPRED)
	   ELSE  ITE.VLRTOT
	END AS VLRTOT,
	CASE
	   WHEN (FEMP.VLRLIQITEMNFE IS NOT NULL AND FEMP.VLRLIQITEMNFE='S') THEN 0
	   ELSE  ITE.PERCDESC
	END AS PERCDESC,
	CASE
	   WHEN (FEMP.VLRLIQITEMNFE IS NOT NULL AND FEMP.VLRLIQITEMNFE='S') THEN 0
	   ELSE  ITE.VLRDESC + ITE.VLRREPRED
	END AS VLRDESC,
	CASE
	   WHEN (FEMP.VLRLIQITEMNFE IS NOT NULL AND FEMP.VLRLIQITEMNFE='S') THEN (ITE.VLRUNIT - (ITE.VLRDESC/ITE.QTDNEG) - (ITE.VLRREPRED/ITE.QTDNEG))
	   ELSE  ITE.VLRUNIT
	END AS VLRUNIT,
	CASE
  	  WHEN (RTRIM(PRO.NCM) IS NOT NULL ) THEN PRO.NCM
	  ELSE IPI.CODFISIPI
	END AS 	CODFISIPI


FROM TGFITE ITE
INNER JOIN TGFCAB CAB  ON (CAB.NUNOTA = ITE.NUNOTA)
INNER JOIN TGFEMP FEMP ON (CAB.CODEMP = FEMP.CODEMP)
INNER JOIN TSIEMP EMP ON (EMP.CODEMP = CAB.CODEMP)
INNER JOIN TGFPRO PRO ON (ITE.CODPROD = PRO.CODPROD)
LEFT JOIN TGFIPI IPI ON (IPI.CODIPI = PRO.CODIPI)
LEFT JOIN TGFCFO CFO ON (CFO.CODCFO = ITE.CODCFO),
TGFLOC LOC
WHERE ITE.NUNOTA IN (
        SELECT DISTINCT RITE.NUNOTA
        FROM AD_TJKCERGARITE RITE
        WHERE RITE.ID = $P{PK_ID} AND RITE.ID IS NOT NULL
    )
    AND ITE.CODPROD IN (
        SELECT RITE.CODPROD
        FROM AD_TJKCERGARITE RITE
        WHERE RITE.ID = $P{PK_ID} AND RITE.ID IS NOT NULL
    )





AND ITE.SEQUENCIA > 0
AND ITE.CODLOCALORIG = LOC.CODLOCAL
AND (

	(ITE.USOPROD <> 'D' ) OR
	( NOT EXISTS (
						SELECT 1
						FROM TGFVAR VAR
						WHERE
							VAR.NUNOTA = ITE.NUNOTA AND
							VAR.NUNOTAORIG = ITE.NUNOTA AND
							VAR.SEQUENCIAORIG = ITE.SEQUENCIA))
    )




),

TABCALC AS (

SELECT

    SUM(TABGAR.VLRUNIT_RITE) AS VALOR,

    CASE WHEN TABGAR.TIPO = 'D' THEN SUM(TABVAR.BASEICMS_UNIT) * TABGAR.QTDNEG  ELSE SUM(TABVAR.BASEICMS_UNIT) END BASEICMS_UNIT,

    CASE WHEN TABGAR.TIPO = 'D' THEN SUM(TABVAR.VLRICMS_UNIT) * TABGAR.QTDNEG ELSE SUM(TABVAR.VLRICMS_UNIT) END VLRICMS_UNIT,

    CASE WHEN TABGAR.TIPO = 'D' THEN SUM(TABVAR.VLRSUBST_UNIT) * TABGAR.QTDNEG ELSE SUM(TABVAR.VLRSUBST_UNIT) END VLRSUBST_UNIT,

	CASE
		WHEN TABGAR.TIPO = 'D' THEN SUM(ISNULL(TABGAR.VLRUNIT_RITE, 0) * ISNULL(TRY_CONVERT(DECIMAL(18, 6), TABGAR.QTDNEG), 1))
		ELSE SUM(ISNULL(TABGAR.VLRUNIT_RITE, 0))
	END AS VLRUNIT_PROD,

    SUM(TABVAR.BASESUBSTIT) AS BASESUBSTIT_UNIT,

    SUM(TABVAR.VLRDESC) AS VLR_DESC,
    SUM(TABVAR.VLR_LIQ) AS VLR_LIQ,
    SUM(TABVAR.VLRUNIT) + SUM(TABVAR.VLRSUBST_UNIT) AS VALOR_NOTA,
    SUM(TABVAR.VLR_LIQ) + SUM(TABVAR.VLRSUBST_UNIT) AS VALOR_NOTA_LIQ,
    SUM(TABVAR.BASEICMS_UNIT) + SUM(TABVAR.VLRSUBST_UNIT) AS VALOR_NOTA_LIQ2


/*IMPOSTOS*/
/*
   TABVAR.BASEICMS,
	TABVAR.VLRICMS,
	TABVAR.BASESUBSTIT,
	TABVAR.VLRSUBST
*/

FROM TABGAR
LEFT JOIN TABVAR ON TABVAR.CODPROD = TABGAR.CODPROD AND TABGAR.NUNOTA = TABVAR.NUNOTA



WHERE
 TABGAR.ID_RITE IN ($P{PK_ID})

GROUP BY
TABGAR.TIPO,
TABGAR.QTDNEG

)

SELECT

	'Base ICMS: ' + CAST(ROUND(SUM(TABCALC.BASEICMS_UNIT), 2) AS VARCHAR) + ' // ' +
	'Valor ICMS: ' + CAST(ROUND(SUM(TABCALC.VLRICMS_UNIT), 2) AS VARCHAR) + ' // ' +
	'Base ST: ' + CAST(ROUND(SUM(TABCALC.BASESUBSTIT_UNIT), 2) AS VARCHAR) + ' // ' +
	'Valor ST: ' + CAST(ROUND(SUM(TABCALC.VLRSUBST_UNIT), 2) AS VARCHAR)  AS OBSERVACCAO


FROM
TABCALC]]>
	</queryString>
	<field name="OBSERVACCAO" class="java.lang.String"/>
	<group name="OBSERVACCAO">
		<groupExpression><![CDATA[$F{OBSERVACCAO}]]></groupExpression>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
	<summary>
		<band height="42" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="9" y="0" width="206" height="32"/>
				<textElement textAlignment="Justified">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{OBSERVACCAO}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
