<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relat_tab_preco" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.25"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="CODEMP" class="java.math.BigDecimal">
		<property name="nomeTabela" value="TSIEMP"/>
		<property name="PESQUISA" value="TRUE"/>
		<parameterDescription><![CDATA[Empresa]]></parameterDescription>
	</parameter>
	<parameter name="TIPO" class="java.lang.Object">
		<property name="Oferta" value="O"/>
		<property name="Normal" value="N"/>
		<parameterDescription><![CDATA[Tipo]]></parameterDescription>
	</parameter>
	<parameter name="CODMARCA" class="java.math.BigDecimal">
		<property name="PESQUISA" value="TRUE"/>
		<property name="nomeTabela" value="TGFMAR"/>
		<parameterDescription><![CDATA[Marca]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	CAST(PRO.REFERENCIA AS VARCHAR(20)) AS CODITEM,
	CAST(PRO.MARCA AS VARCHAR(20)) AS MARCA,
	CAST(ISNULL(EXC.VLRVENDA, 0) AS DECIMAL(19,4)) AS VLRUNIT,
	CAST(CASE
			WHEN P.CODEMP IN (1,4,8,9)
				THEN ISNULL(SANKHYA.AD_GET_VLRSUBST_DPS(P.CODEMP, 721, EXC.CODPROD, ISNULL(EXC.VLRVENDA, 0)), 0)
			ELSE 0
		 END AS DECIMAL(19,4)) AS VLRST,
	CAST(ISNULL(EXC.VLRVENDA, 0) +
		 CASE
			WHEN P.CODEMP IN (1,4,8,9)
				THEN ISNULL(SANKHYA.AD_GET_VLRSUBST_DPS(P.CODEMP, 721, EXC.CODPROD, ISNULL(EXC.VLRVENDA, 0)), 0)
			ELSE 0
		 END AS DECIMAL(19,4)) AS VLRVENDA,
	SUBSTRING(ISNULL(PRO.OBSETIQUETA, ''), 1, 50) AS APLICACAO,
	SUBSTRING(ISNULL(PRO.DESCRPROD, ''), 1, 30) AS DESCRICAO,
	EXC.AD_DTINICIO AS DTINICIO,
	EXC.AD_DTFIM AS DTFIM,
	EXC.CODPROD AS CODPROD
FROM TGFEXC EXC
INNER JOIN TGFPRO PRO ON PRO.CODPROD = EXC.CODPROD
CROSS APPLY (
	SELECT
		CAST($P{CODEMP} AS INT) AS CODEMP,
		CASE
			WHEN CAST($P{TIPO} AS CHAR(1)) = 'P' THEN ISNULL(E.AD_CODTABPROMOCAO, 0)
			ELSE ISNULL(E.AD_CODTABOFERTA, 0)
		END AS CODTAB,
		CONVERT(SMALLDATETIME, CONVERT(CHAR(10), GETDATE(), 103), 103) AS DTVIGOR
	FROM TGFEMP E
	WHERE E.CODEMP = CAST($P{CODEMP} AS INT)
) P
WHERE EXC.NUTAB = (
	SELECT TOP 1 T.NUTAB
	FROM TGFTAB T
	WHERE T.CODTAB = P.CODTAB
	  AND T.DTVIGOR <= P.DTVIGOR
	ORDER BY T.DTVIGOR DESC
)
AND (
    $P{CODMARCA} IS NULL
    OR CAST($P{CODMARCA} AS INT) = 0
    OR PRO.CODMARCA = CAST($P{CODMARCA} AS INT)
)
AND P.DTVIGOR BETWEEN EXC.AD_DTINICIO AND EXC.AD_DTFIM
ORDER BY PRO.MARCA, PRO.REFERENCIA]]>
	</queryString>
	<field name="CODITEM" class="java.lang.String"/>
	<field name="MARCA" class="java.lang.String"/>
	<field name="VLRUNIT" class="java.math.BigDecimal"/>
	<field name="VLRST" class="java.math.BigDecimal"/>
	<field name="VLRVENDA" class="java.math.BigDecimal"/>
	<field name="APLICACAO" class="java.lang.String"/>
	<field name="DESCRICAO" class="java.lang.String"/>
	<field name="DTINICIO" class="java.sql.Timestamp"/>
