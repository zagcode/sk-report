				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{VLRNOTA}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="296" y="0" width="147" height="15">
					<printWhenExpression><![CDATA[$F{VALOR_DEVOLVIDO} != null]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[String.valueOf($F{NF_DEVOLUCAO} == null ? "ACERTO MANUAL" : $F{NF_DEVOLUCAO})]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="462" y="0" width="90" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{VALOR_DEVOLVIDO} == null ? "-" : new java.text.DecimalFormat("#,##0.00").format($F{VALOR_DEVOLVIDO})]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
