<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Relatorio Semanal_credito" language="groovy" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.3310000000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NURENEG" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="CODPARC" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
     FIN_COMP.NUNOTA,FIN_CRED.NUMNOTA,
    max(DEV.NUMNOTA) as NF_DEVOLUCAO, FIN_CRED.VLRDESDOB as VALOR
    FROM TGFFIN FIN_COMP
    JOIN TGFFIN FIN_CRED
      ON FIN_COMP.NUCOMPENS = FIN_CRED.NUCOMPENS
     AND FIN_COMP.VLRDESDOB = FIN_CRED.VLRDESDOB
     AND FIN_COMP.NUFIN <> FIN_CRED.NUFIN
     AND FIN_CRED.CODTIPTIT = 31
    LEFT JOIN TGFCAB DEV
      ON DEV.NUNOTA = FIN_COMP.NUNOTA
     AND DEV.TIPMOV = 'D'
INNER JOIN AD_TDPSRENEGPARC TDPS ON (TDPS.NURENEG = $P{NURENEG})
where
FIN_COMP.codparc = $P{CODPARC}
AND (
    (TDPS.DTINIRENEG IS NULL AND TDPS.DTFIMRENEG IS NULL)
    OR (FIN_CRED.DTNEG >= TDPS.DTINIRENEG AND FIN_CRED.DTNEG <= TDPS.DTFIMRENEG)
  )
    GROUP BY FIN_COMP.NUNOTA, FIN_CRED.NUMNOTA, DEV.NUMNOTA, FIN_CRED.VLRDESDOB
ORDER BY FIN_CRED.NUMNOTA]]>
	</queryString>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="NF_DEVOLUCAO" class="java.math.BigDecimal"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<variable name="VLRNOTATOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALOR}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="Count">
		<variableExpression><![CDATA[java.math.BigDecimal.ONE]]></variableExpression>
	</variable>
	<columnHeader>
		<band height="35">
			<staticText>
				<reportElement x="180" y="0" width="176" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[CRÉDITOS POR NOTA]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="20" width="60" height="15"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Número]]></text>
			</staticText>
			<staticText>
				<reportElement x="225" y="20" width="68" height="15"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[NF Devolução]]></text>
			</staticText>
			<staticText>
				<reportElement x="444" y="19" width="100" height="15"/>
				<textElement textAlignment="Right">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Valor Devolução]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="34" width="555" height="1"/>
			</line>
		</band>
	</columnHeader>
	<detail>
		<band height="15" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="60" height="15"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{NUMNOTA}]]></textFieldExpression>
			</textField>
			<textField pattern="">
				<reportElement x="225" y="0" width="100" height="15"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{NF_DEVOLUCAO}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="444" y="0" width="100" height="15"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{VALOR}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band height="17" splitType="Stretch">
			<staticText>
				<reportElement x="355" y="1" width="89" height="15"/>
				<textElement textAlignment="Right">
					<font size="9"/>
				</textElement>
				<text><![CDATA[Valor Total:]]></text>
			</staticText>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="444" y="1" width="100" height="15"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{VLRNOTATOTAL}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="2" width="60" height="15"/>
				<textElement/>
				<text><![CDATA[Total Notas:]]></text>
			</staticText>
			<textField>
				<reportElement x="60" y="2" width="81" height="15"/>
				<textElement/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{QTDNOTAS}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="0" width="555" height="1"/>
			</line>
		</band>
	</columnFooter>
</jasperReport>
