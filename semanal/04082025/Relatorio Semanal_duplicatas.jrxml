	<property name="ireport.definition"/>
	<parameter name="NURENEG" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT FIN.NUMNOTA,FIN.NUFIN, FIN.NURENEG, FIN.DESDOBRAMENTO, FIN.VLRDESDOB, FIN.DTVENC
FROM TGFFIN FIN
WHERE FIN.NURENEG = $P{NURENEG}
  AND FIN.RECDESP <> 0
ORDER BY FIN.DTVENC]]>
	</queryString>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="NUFIN" class="java.math.BigDecimal"/>
	<field name="NURENEG" class="java.math.BigDecimal"/>
	<field name="DESDOBRAMENTO" class="java.lang.String"/>
