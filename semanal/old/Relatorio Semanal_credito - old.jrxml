<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Relatorio Semanal_credito" language="groovy" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.143588810000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NURENEG" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
    CASE WHEN FRE.NUFINORIG <> '0' THEN FRE.NUFINORIG ELSE 0 END AS NUFINORIG,
    CASE WHEN FRE.NUFINORIG <> '0' THEN FIN.RECDESP ELSE 0 END AS RECDESP,
    CASE WHEN FRE.NUFINORIG <> '0' THEN FIN.CODPARC ELSE 0 END AS CODPARC,
    CASE WHEN FRE.NUFINORIG <> '0' THEN FIN.NUMNOTA ELSE 0 END AS NUMNOTA_CREDITO,
    CASE WHEN FRE.NUFINORIG <> '0' THEN FIN.DTNEG ELSE 0 END AS DTNEG,
    CASE WHEN FRE.NUFINORIG <> '0' THEN CAB.VLRNOTA ELSE 0 END AS VALOR_CREDITO
FROM TGFFRE FRE
JOIN TGFFIN FIN ON FIN.NUFIN = FRE.NUFIN
JOIN TGFCAB CAB ON CAB.NUNOTA = FIN.NUNOTA
WHERE FIN.DHBAIXA IS NOT NULL
  AND FIN.NUCOMPENS IS NOT NULL
  AND FIN.CODPARC = (SELECT MAX(CODPARC) FROM TGFFIN WHERE NURENEG IN ($P{NURENEG}))
  AND TIPACERTO = 'C'
  AND FIN.RECDESP = -1
  AND FRE.NUFINORIG IS NOT NULL
ORDER BY FIN.DTNEG]]>
	</queryString>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="NF" class="java.math.BigDecimal"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<variable name="VLRNOTATOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALOR}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="Count">
		<variableExpression><![CDATA[java.math.BigDecimal.ONE]]></variableExpression>
	</variable>
	<columnHeader>
		<band height="35">
			<staticText>
				<reportElement x="180" y="0" width="176" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[CRÉDITO ACUMULADO]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="20" width="60" height="15"/>
