				<text><![CDATA[Valor NF]]></text>
			</staticText>
			<staticText>
				<reportElement x="296" y="21" width="122" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Créditos Aplicados]]></text>
			</staticText>
			<staticText>
				<reportElement x="430" y="21" width="122" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Saldo]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="34" width="555" height="1"/>
			</line>
		</band>
	</columnHeader>
	<detail>
		<band height="15">
			<textField>
				<reportElement x="1" y="0" width="72" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{NUMNOTA}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="86" y="0" width="26" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{SERIENOTA}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="128" y="0" width="63" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.sql.Timestamp"><![CDATA[$F{DTNEG}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="216" y="0" width="80" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{VLRNOTA}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="446" y="0" width="90" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{VALOR_DEVOLVIDO} == null ? new java.text.DecimalFormat("#,##0.00").format($F{VLRNOTA}) : new java.text.DecimalFormat("#,##0.00").format(($F{VLRNOTA}.subtract( $F{VALOR_DEVOLVIDO})))]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="311" y="0" width="90" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{VALOR_DEVOLVIDO} == null ? "-" : new java.text.DecimalFormat("#,##0.00").format($F{VALOR_DEVOLVIDO})]]></textFieldExpression>
			</textField>
		</band>
