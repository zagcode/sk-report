<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Relatorio Semanal_fechamento" language="groovy" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.3310000000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NURENEG" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="CODPARC" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[WITH TDPS_BASE AS (
    SELECT
        TDPS.CODEMP,
        TDPS.NURENEG,
        MIN(TDPS.DTINIRENEG) AS DTINI_TDPS,
        MAX(TDPS.DTFIMRENEG) AS DTFIM_TDPS
    FROM AD_TDPSRENEGPARC TDPS
    WHERE TDPS.NURENEG = $P{NURENEG}
    GROUP BY TDPS.CODEMP, TDPS.NURENEG
),
FAIXA_FIN AS (
    SELECT
        MIN(FINR.DTNEG) AS DTINI_FIN
    FROM TGFFIN FINR
    WHERE FINR.NURENEG = $P{NURENEG}
),
PARAM_RENEG AS (
    SELECT
        B.CODEMP,
        B.NURENEG,
        CASE
            WHEN B.DTINI_TDPS IS NULL THEN F.DTINI_FIN
            WHEN F.DTINI_FIN IS NULL THEN B.DTINI_TDPS
            WHEN B.DTINI_TDPS <= F.DTINI_FIN THEN B.DTINI_TDPS
            ELSE F.DTINI_FIN
        END AS DTINI_USADA,
        B.DTFIM_TDPS AS DTFIM_USADA
    FROM TDPS_BASE B
    CROSS JOIN FAIXA_FIN F
),
-- DEV_INFO: casa cada nota faturada com o crédito de devolução (CODTIPTIT = 20) que a abateu.
-- Só via NUCOMPENS (compensação formal no financeiro) — mesmo critério do bucket "Automático" em _creditos.jrxml.
-- As antigas "Opção 2" (mesmo parceiro + valor + data ≤120 dias) e "Opção 3" (só valor + data) foram REMOVIDAS:
-- confirmado por teste real no banco (NUNOTA=824986/NUMNOTA=290801, cliente 2572, financeiro confirmou SEM abatimento)
-- que elas casam por pura coincidência de valor — essa nota tem NUCOMPENS = NULL (nenhuma compensação de verdade)
-- e a Opção 2 somou 2 devoluções não relacionadas (306816 e 307551) só porque ambas valem R$ 6,05, gerando um
-- crédito fantasma de 12,10. Sem vínculo contábil real (NUCOMPENS), não há como confiar nesse casamento.
DEV_INFO AS (
    SELECT
        X.NUNOTA_ORIG,
        STRING_AGG(CAST(X.NUMNOTA_DEV AS VARCHAR(MAX)), ' / ') AS NF_DEVOLUCAO,
        SUM(X.VLRNOTA_DEV) AS VALOR_DEVOLVIDO
    FROM (
        SELECT DISTINCT
            FIN_COMP.NUNOTA AS NUNOTA_ORIG,
            DEV.NUNOTA      AS NUNOTA_DEV,
            DEV.NUMNOTA     AS NUMNOTA_DEV,
            ABS(FIN_CRED.VLRDESDOB) AS VLRNOTA_DEV
        FROM TGFFIN FIN_COMP
        INNER JOIN TGFFIN FIN_CRED
            ON FIN_CRED.NUCOMPENS = FIN_COMP.NUCOMPENS
           AND FIN_COMP.VLRDESDOB = FIN_CRED.VLRDESDOB
           AND FIN_COMP.NUFIN <> FIN_CRED.NUFIN
           AND FIN_CRED.CODTIPTIT = 20
        INNER JOIN TGFCAB DEV
            ON DEV.NUNOTA = FIN_CRED.NUNOTA
           AND DEV.TIPMOV = 'D'
    ) X
    GROUP BY X.NUNOTA_ORIG
)
SELECT
    CAB.NUMNOTA,
    CAB.SERIENOTA,
    CAB.DTNEG,
    CAB.VLRNOTA,
    CAB.NUNOTA,
    DEV_INFO.NF_DEVOLUCAO,
    -- trava de segurança: crédito aplicado a uma nota nunca pode passar do valor da própria nota (Saldo nunca fica negativo)
    CASE
        WHEN COALESCE(DEV_INFO.VALOR_DEVOLVIDO, 0) > CAB.VLRNOTA THEN CAB.VLRNOTA
        ELSE COALESCE(DEV_INFO.VALOR_DEVOLVIDO, 0)
    END AS VALOR_DEVOLVIDO
FROM TGFCAB CAB
LEFT JOIN DEV_INFO
    ON DEV_INFO.NUNOTA_ORIG = CAB.NUNOTA
WHERE CAB.SERIENOTA IS NOT NULL
  AND CAB.TIPMOV <> 'D'
  AND CAB.STATUSNFE = 'A'
  AND EXISTS (
      SELECT 1
      FROM TGFFIN FIN
      INNER JOIN PARAM_RENEG P
         ON P.CODEMP = CAB.CODEMP
      WHERE FIN.NUNOTA = CAB.NUNOTA
        AND FIN.CODPARC = $P{CODPARC}
        AND FIN.CODTIPTIT = 31 -- só notas ainda no "estágio" do semanal; título com outro tipo já foi cobrado/pago por fora e não deve entrar no Faturamento Acumulado
        AND (FIN.NURENEG = P.NURENEG OR FIN.NURENEG IS NULL)
        AND (P.DTINI_USADA IS NULL OR FIN.DTNEG >= P.DTINI_USADA)
        AND (P.DTFIM_USADA IS NULL OR FIN.DTNEG <= P.DTFIM_USADA)
  )
ORDER BY CAB.NUMNOTA;]]>
	</queryString>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="SERIENOTA" class="java.lang.String"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="VLRNOTA" class="java.math.BigDecimal"/>
	<field name="NUNOTA" class="java.math.BigDecimal"/>
	<field name="NF_DEVOLUCAO" class="java.lang.String"/>
	<field name="VALOR_DEVOLVIDO" class="java.math.BigDecimal"/>
	<variable name="VLRNOTATOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRNOTA}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="Count">
		<variableExpression><![CDATA[java.math.BigDecimal.ONE]]></variableExpression>
	</variable>
	<variable name="VLRTOTALABATIDO" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALOR_DEVOLVIDO} == null ? java.math.BigDecimal.ZERO : $F{VALOR_DEVOLVIDO}]]></variableExpression>
	</variable>
	<variable name="VALOR_DEVOLVIDO_TEXTO" class="java.lang.String">
		<variableExpression><![CDATA[$F{VALOR_DEVOLVIDO} == null ? "-" : new java.text.DecimalFormat("#,##0.00").format($F{VALOR_DEVOLVIDO})]]></variableExpression>
	</variable>
	<variable name="VALOR_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRNOTA}.subtract($F{VALOR_DEVOLVIDO} == null ? BigDecimal.ZERO : $F{VALOR_DEVOLVIDO})]]></variableExpression>
	</variable>
