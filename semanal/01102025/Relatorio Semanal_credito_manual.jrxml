<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Relatorio Semanal_credito_manual" language="groovy" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.3310000000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NURENEG" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="CODPARC" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[select f.NUFIN, f.NUMNOTA, f.VLRDESDOB, CAB.VLRNOTA from tgffin f
INNER JOIN AD_TDPSRENEGPARC TDPS ON (TDPS.NURENEG = $P{NURENEG})
INNER JOIN TGFCAB CAB on f.numnota = CAB.NUMNOTA
where f.codparc = $P{CODPARC}
AND (
    (TDPS.DTINIRENEG IS NULL AND TDPS.DTFIMRENEG IS NULL)
    OR (f.DTNEG >= TDPS.DTINIRENEG AND f.DTNEG <= TDPS.DTFIMRENEG)
  )
and f.codtiptit = 20
and f.AD_FATURASEMANAL = 'SEMBAIXADO'
and f.recdesp = 1]]>
	</queryString>
	<field name="NUFIN" class="java.math.BigDecimal"/>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="VLRDESDOB" class="java.math.BigDecimal"/>
	<field name="VLRNOTA" class="java.math.BigDecimal"/>
	<variable name="VLRNOTAABAT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRDESDOB}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{NUMNOTA}]]></variableExpression>
	</variable>
	<variable name="VLRTOTAL" class="java.math.BigDecimal" calculation="Sum"/>
	<columnHeader>
		<band height="35">
			<staticText>
				<reportElement x="180" y="0" width="237" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[CRÉDITOS ABATIDOS MANUALMENTE]]></text>
			</staticText>
			<staticText>
				<reportElement x="141" y="20" width="84" height="15"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Valor NF]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="20" width="73" height="15"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[NF Abatimento]]></text>
			</staticText>
			<staticText>
				<reportElement x="281" y="19" width="100" height="15"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Financeiro]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="34" width="555" height="1"/>
			</line>
			<staticText>
				<reportElement x="444" y="20" width="100" height="15"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Valor Abatimento]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="15" splitType="Stretch">
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement x="141" y="0" width="71" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{VLRNOTA}]]></textFieldExpression>
			</textField>
			<textField pattern="">
				<reportElement x="0" y="0" width="105" height="15"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{NUMNOTA}]]></textFieldExpression>
			</textField>
			<textField pattern="">
				<reportElement x="281" y="0" width="100" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{NUFIN}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="444" y="0" width="100" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{VLRDESDOB}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band height="17" splitType="Stretch">
			<staticText>
				<reportElement x="168" y="0" width="113" height="15"/>
				<textElement textAlignment="Center">
					<font size="10"/>
				</textElement>
				<text><![CDATA[]]></text>
			</staticText>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement x="281" y="0" width="100" height="15"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="2" width="60" height="15"/>
