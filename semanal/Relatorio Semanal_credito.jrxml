<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Relatorio Semanal_credito" language="groovy" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.3310000000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NURENEG" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="CODPARC" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[WITH Comp AS (
    SELECT
        FIN_COMP.NUCOMPENS,
        FIN_COMP.NUNOTA,
        FIN_COMP.VLRDESDOB,
        ROW_NUMBER() OVER (
            PARTITION BY FIN_COMP.NUCOMPENS, FIN_COMP.VLRDESDOB
            ORDER BY FIN_COMP.NUFIN
        ) AS RN
    FROM TGFFIN FIN_COMP
    JOIN TGFCAB DEV
      ON DEV.NUNOTA = FIN_COMP.NUNOTA
     AND DEV.TIPMOV = 'D'
    WHERE FIN_COMP.CODPARC = $P{CODPARC}
      AND FIN_COMP.NUCOMPENS IS NOT NULL
),
Cred AS (
    SELECT
        FIN_CRED.NUCOMPENS,
        FIN_CRED.NUMNOTA,
        FIN_CRED.NUFIN,
        FIN_CRED.VLRDESDOB,
        FIN_CRED.DTNEG,
        ROW_NUMBER() OVER (
            PARTITION BY FIN_CRED.NUCOMPENS, FIN_CRED.VLRDESDOB
            ORDER BY FIN_CRED.NUFIN
        ) AS RN
    FROM TGFFIN FIN_CRED
    WHERE FIN_CRED.CODTIPTIT = 31
      AND FIN_CRED.RECDESP = 1
),
BaseData AS (
    SELECT
        DEV.NUMNOTA as NF_DEVOLUCAO,
        DEV.VLRNOTA AS TOTAL,
        CRED.NUMNOTA as FIN_CRED_NUMNOTA,
        CRED.NUFIN,
        CRED.VLRDESDOB as VALOR
    FROM Comp
    JOIN Cred CRED
      ON CRED.NUCOMPENS = Comp.NUCOMPENS
     AND CRED.VLRDESDOB = Comp.VLRDESDOB
     AND CRED.RN = Comp.RN
    JOIN TGFCAB DEV
      ON DEV.NUNOTA = Comp.NUNOTA
     AND DEV.TIPMOV = 'D'
    INNER JOIN AD_TDPSRENEGPARC TDPS ON (TDPS.NURENEG = $P{NURENEG})
    WHERE (
        (TDPS.DTINIRENEG IS NULL AND TDPS.DTFIMRENEG IS NULL)
        OR (CRED.DTNEG >= TDPS.DTINIRENEG AND CRED.DTNEG <= TDPS.DTFIMRENEG)
    )
)
SELECT
    NF_DEVOLUCAO,
    TOTAL,
    FIN_CRED_NUMNOTA,
    CASE WHEN (TOTAL < SUM(VALOR)) THEN TOTAL ELSE (SUM(VALOR)) END as VALOR_SOMADO
FROM BaseData
GROUP BY
    NF_DEVOLUCAO,
    TOTAL,
    FIN_CRED_NUMNOTA
ORDER BY
    NF_DEVOLUCAO;]]>
	</queryString>
	<field name="NF_DEVOLUCAO" class="java.math.BigDecimal"/>
	<field name="VALOR_SOMADO" class="java.math.BigDecimal"/>
	<field name="FIN_CRED_NUMNOTA" class="java.math.BigDecimal"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<variable name="VLRNOTAABAT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALOR_SOMADO}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{NF_DEVOLUCAO}]]></variableExpression>
	</variable>
	<variable name="VLRTOTAL" class="java.math.BigDecimal" calculation="Sum"/>
