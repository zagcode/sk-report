<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Relatorio Semanal_v2_acertos2" language="groovy" pageWidth="270" pageHeight="802" columnWidth="270" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NURENEG" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT ---DISTINCT
        FIN.CODPARC,
        FIN.DTNEG,
        FIN.NUFIN AS NUFIN_DEBITO,
        FIN.RECDESP,
        FIN.NUMNOTA AS NUMNOTA_DEBITO,
        FIN.VLRDESDOB AS VALOR_DEBITO
    FROM TGFFRE FRE
    JOIN TGFFIN FIN ON FIN.NUFIN = FRE.NUFIN
    WHERE FIN.DHBAIXA IS NOT NULL
      AND FIN.NUCOMPENS IS NOT NULL
      AND FIN.CODPARC = (SELECT MAX(CODPARC) FROM TGFFIN WHERE NURENEG IN ($P{NURENEG}))
      AND TIPACERTO = 'C'
      AND FIN.RECDESP = 1

     ORDER BY
        FIN.DTNEG]]>
	</queryString>
	<field name="CODPARC" class="java.lang.Integer"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="NUFIN_DEBITO" class="java.lang.Integer"/>
	<field name="RECDESP" class="java.lang.Short"/>
	<field name="NUMNOTA_DEBITO" class="java.lang.Integer"/>
	<field name="VALOR_DEBITO" class="java.lang.Double"/>
	<variable name="VLR_TOTAL" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{VALOR_DEBITO}]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<columnHeader>
		<band height="45" splitType="Stretch">
			<staticText>
				<reportElement x="97" y="27" width="75" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[N. da Nota]]></text>
			</staticText>
			<staticText>
				<reportElement x="172" y="27" width="75" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Vlr.Débito]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="3" y="3" width="263" height="15" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="none">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[NOTAS DE DÉBITO]]></text>
			</staticText>
			<line>
				<reportElement x="3" y="42" width="260" height="1"/>
			</line>
			<staticText>
				<reportElement x="17" y="27" width="75" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Data]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22" splitType="Stretch">
			<textField pattern="###0">
				<reportElement x="97" y="2" width="75" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{NUMNOTA_DEBITO}]]></textFieldExpression>
			</textField>
			<textField pattern="¤ #,##0.00">
				<reportElement x="172" y="2" width="75" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{VALOR_DEBITO}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="17" y="2" width="75" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[$F{DTNEG}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<lastPageFooter>
		<band height="24">
			<textField pattern="¤ #,##0.00">
				<reportElement x="172" y="5" width="75" height="15"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$V{VLR_TOTAL}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="135" y="5" width="37" height="15"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Total:]]></text>
			</staticText>
			<line>
				<reportElement x="4" y="0" width="259" height="1"/>
			</line>
			<line>
				<reportElement x="4" y="21" width="259" height="1"/>
			</line>
		</band>
	</lastPageFooter>
</jasperReport>
