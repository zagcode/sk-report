<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Relatorio Semanal_V2" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.4641000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<import value="com.sankhya.util.*"/>
	<parameter name="NURENEG" class="java.math.BigDecimal"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\Cristian\\OneDrive\\Sankhya\\Clientes\\Parana\\DPS\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT EMP.CODEMP,
  UPPER(EMP.RAZAOSOCIAL) AS RAZAOSOCIAL,
  UPPER(EMP.NOMEFANTASIA) AS NOMEFANTASIA,
  PAR.CODPARC,
  PAR.NOMEPARC,
  PAR.CGC_CPF,
  PAR.IDENTINSCESTAD,
  ENDE.TIPO + ' ' + ENDE.NOMEEND + ', ' + PAR.NUMEND + ' ' + PAR.COMPLEMENTO AS ENDERECO,
  CID.NOMECID,
  UFS.UF,
  VEN.APELIDO,
  CAB.NUMNOTA,
  CAB.SERIENOTA,
  CAB.DTNEG,
  CAB.VLRNOTA
FROM TGFCAB CAB
  INNER JOIN TSIEMP EMP ON (CAB.CODEMP = EMP.CODEMP)
INNER JOIN TGFPAR PAR ON (PAR.CODPARC = (SELECT MAX(CODPARC) FROM TGFFIN WHERE NURENEG = $P{NURENEG}))
  INNER JOIN TSIEND ENDE ON (ENDE.CODEND = PAR.CODEND)
  INNER JOIN TSICID CID ON (CID.CODCID = PAR.CODCID)
  INNER JOIN TSIUFS UFS ON (UFS.CODUF = CID.UF)
  INNER JOIN TGFVEN VEN ON (VEN.CODVEND = CAB.CODVEND)
WHERE CAB.NUNOTA IN (SELECT NUNOTA FROM TGFFIN WHERE NURENEG = $P{NURENEG})]]>
	</queryString>
	<field name="CODEMP" class="java.lang.Short"/>
	<field name="RAZAOSOCIAL" class="java.lang.String"/>
	<field name="NOMEFANTASIA" class="java.lang.String"/>
	<field name="CODPARC" class="java.lang.Integer"/>
	<field name="NOMEPARC" class="java.lang.String"/>
	<field name="CGC_CPF" class="java.lang.String"/>
	<field name="IDENTINSCESTAD" class="java.lang.String"/>
	<field name="ENDERECO" class="java.lang.String"/>
	<field name="NOMECID" class="java.lang.String"/>
	<field name="UF" class="java.lang.String"/>
	<field name="APELIDO" class="java.lang.String"/>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="SERIENOTA" class="java.lang.String"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="VLRNOTA" class="java.math.BigDecimal"/>
	<variable name="VLRNOTATOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRNOTA}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="Count">
		<variableExpression><![CDATA[java.math.BigDecimal.ONE]]></variableExpression>
	</variable>
