<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rel_sub_comissionado_dev" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.8181818181818215"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="DATA_NEG_INI" class="java.sql.Timestamp" isForPrompting="false">
		<property name="TGFCAB" value="DTNEG"/>
		<parameterDescription><![CDATA[DT. de Negociação(inicio)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_NEG_FIN" class="java.sql.Timestamp" isForPrompting="false">
		<property name="TGFCAB" value="DTNEG"/>
		<parameterDescription><![CDATA[Dt. de Negociação(final)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CODEMP" class="java.math.BigDecimal" isForPrompting="false">
		<property name="PESQUISA" value="true"/>
		<property name="NOMETABELA" value="TSIEMP"/>
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CODVEND" class="java.math.BigDecimal" isForPrompting="false">
		<property name="PESQUISA" value="true"/>
		<property name="NOMETABELA" value="TGFVEN"/>
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\rique\\Desktop\\Rel. Comissão\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
    DEV.CODPARC,
    PAR.NOMEPARC,
    DEV.DTNEG,
    DEV.NUMNOTA,
    DEV.NUNOTA,
	DEV.VLRNOTA AS VALORNOTA_BRUTO,
	SUM(ITE_DEV.VLRTOT - ITE_DEV.VLRDESC - ITE_DEV.VLRREPRED - ITE_DEV.VLRIPI) AS VALORLIQ,
    ISNULL(SUM(COM.VLRCOM_REP), 0) AS VALOR_COMISSAO

FROM
    TGFCAB DEV
    INNER JOIN TGFITE ITE_DEV ON ITE_DEV.NUNOTA = DEV.NUNOTA
    INNER JOIN TGFPAR PAR ON PAR.CODPARC = DEV.CODPARC
    INNER JOIN TGFVAR VAR_NOTA ON (VAR_NOTA.NUNOTA = ITE_DEV.NUNOTA AND VAR_NOTA.SEQUENCIA = ITE_DEV.SEQUENCIA)
    LEFT JOIN AD_COMISSAODPS COM ON (COM.NUNOTA = VAR_NOTA.NUNOTAORIG AND COM.SEQUENCIA = VAR_NOTA.SEQUENCIAORIG)

WHERE
    DEV.CODEMP IN ($P{CODEMP})
    AND (DEV.DTNEG BETWEEN $P{DATA_NEG_INI} AND $P{DATA_NEG_FIN})
    AND (ITE_DEV.CODVEND = $P{CODVEND})

    AND DEV.CODTIPOPER IN ('1200','1201')
    AND DEV.STATUSNOTA = 'L'

GROUP BY
    DEV.CODPARC,
    PAR.NOMEPARC,
    DEV.DTNEG,
    DEV.NUMNOTA,
    DEV.NUNOTA,
    DEV.VLRNOTA

UNION ALL

SELECT DISTINCT
    DEV.CODPARC,
    PAR.NOMEPARC,
    DEV.DTNEG,
    DEV.NUMNOTA,
    DEV.NUNOTA,
	DEV.VLRNOTA AS VALORNOTA_BRUTO,
	SUM(ITE_DEV.VLRTOT - ITE_DEV.VLRDESC - ITE_DEV.VLRREPRED - ITE_DEV.VLRIPI) AS VALORLIQ,
    ISNULL(SUM(COM.VLRCOM_ATE), 0) AS VALOR_COMISSAO

FROM
    TGFCAB DEV
    INNER JOIN TGFITE ITE_DEV ON ITE_DEV.NUNOTA = DEV.NUNOTA
    INNER JOIN TGFPAR PAR ON PAR.CODPARC = DEV.CODPARC
    INNER JOIN TGFVAR VAR_NOTA ON (VAR_NOTA.NUNOTA = ITE_DEV.NUNOTA AND VAR_NOTA.SEQUENCIA = ITE_DEV.SEQUENCIA)
    LEFT JOIN AD_COMISSAODPS COM ON (COM.NUNOTA = VAR_NOTA.NUNOTAORIG AND COM.SEQUENCIA = VAR_NOTA.SEQUENCIAORIG)

WHERE
    DEV.CODEMP IN ($P{CODEMP})
    AND (DEV.DTNEG BETWEEN $P{DATA_NEG_INI} AND $P{DATA_NEG_FIN})
    AND (ITE_DEV.CODEXEC = $P{CODVEND})

    AND DEV.CODTIPOPER IN ('1200','1201')
    AND DEV.STATUSNOTA = 'L'

GROUP BY
    DEV.CODPARC,
    PAR.NOMEPARC,
    DEV.DTNEG,
    DEV.NUMNOTA,
    DEV.NUNOTA,
    DEV.VLRNOTA

ORDER BY
    DEV.CODPARC, DEV.DTNEG, DEV.NUMNOTA]]>
	</queryString>
	<field name="CODPARC" class="java.lang.Integer"/>
	<field name="NOMEPARC" class="java.lang.String"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="NUMNOTA" class="java.lang.Integer"/>
	<field name="NUNOTA" class="java.lang.Integer"/>
	<field name="VALORNOTA_BRUTO" class="java.math.BigDecimal"/>
	<field name="VALORLIQ" class="java.math.BigDecimal"/>
	<field name="VALOR_COMISSAO" class="java.math.BigDecimal"/>
	<variable name="VALOR_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALORLIQ}]]></variableExpression>
	</variable>
	<variable name="VALOR_COMISSAO" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALOR_COMISSAO}]]></variableExpression>
	</variable>
