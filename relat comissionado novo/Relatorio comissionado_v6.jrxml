	<parameter name="DATA_NEG_INI" class="java.sql.Timestamp">
		<property name="TGFCAB" value="DTNEG"/>
		<parameterDescription><![CDATA[DT. de Negociação(inicio)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_NEG_FIN" class="java.sql.Timestamp">
		<property name="TGFCAB" value="DTNEG"/>
		<parameterDescription><![CDATA[Dt. de Negociação(final)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CODEMP" class="java.lang.String">
		<property name="PESQUISA" value="true"/>
		<property name="NOMETABELA" value="TSIEMP"/>
		<parameterDescription><![CDATA[Cód.Empresa]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CODVEND" class="java.lang.String">
		<property name="PESQUISA" value="true"/>
		<property name="NOMETABELA" value="TGFVEN"/>
		<parameterDescription><![CDATA[Cód.Vendedor]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="TIPO_CLASSE" class="java.lang.String">
		<property name="TYPE" value="S"/>
		<property name="NOMECAMPO" value="TGFVEN.AD_TPCLASSE"/>
		<parameterDescription><![CDATA[Tipo Classe]]></parameterDescription>
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    CODEMP,
    CODVEND,
    NOVEVEND,
    NOMEPAR
FROM (
-- Primeira consulta (vendedor principal)
SELECT
    COM.CODEMP,
    VEN.CODVEND,
    VEN.APELIDO AS NOVEVEND,
    VPAR.NOMEPARC AS NOMEPAR
FROM AD_COMISSAODPS COM
INNER JOIN TGFVEN VEN ON VEN.CODVEND = COM.CODVEND
INNER JOIN TGFPAR VPAR ON VPAR.CODPARC = VEN.CODPARC
WHERE COM.DTNEG BETWEEN $P{DATA_NEG_INI} AND $P{DATA_NEG_FIN}
    AND COM.CODEMP = $P{CODEMP}
    -- Se vendedor informado, filtra por ele; senão, filtra por tipo_classe
    AND (
        ($P{CODVEND} IS NOT NULL AND VEN.CODVEND = $P{CODVEND})
        OR
        ($P{CODVEND} IS NULL AND VEN.AD_TPCLASSE = $P{TIPO_CLASSE})
    )
GROUP BY
    COM.CODEMP,
    VEN.CODVEND,
    VEN.APELIDO,
    VPAR.NOMEPARC

UNION ALL

-- Segunda consulta (vendedor alternativo - CODVENDATE)
SELECT
    COM.CODEMP,
    VEN.CODVEND,
    VEN.APELIDO AS NOVEVEND,
    VPAR.NOMEPARC AS NOMEPAR
FROM AD_COMISSAODPS COM
INNER JOIN TGFVEN VEN ON VEN.CODVEND = COM.CODVENDATE
INNER JOIN TGFPAR VPAR ON VPAR.CODPARC = VEN.CODPARC
WHERE COM.DTNEG BETWEEN $P{DATA_NEG_INI} AND $P{DATA_NEG_FIN}
    AND COM.CODEMP = $P{CODEMP}
    AND COM.CODVENDATE IS NOT NULL
    -- Se vendedor informado, filtra por ele; senão, filtra por tipo_classe
    AND (
        ($P{CODVEND} IS NOT NULL AND VEN.CODVEND = $P{CODVEND})
        OR
        ($P{CODVEND} IS NULL AND VEN.AD_TPCLASSE = $P{TIPO_CLASSE})
    )
GROUP BY
    COM.CODEMP,
    VEN.CODVEND,
    VEN.APELIDO,
    VPAR.NOMEPARC

) T
GROUP BY
    CODEMP,
    CODVEND,
    NOVEVEND,
    NOMEPAR
ORDER BY CODVEND]]>
	</queryString>
