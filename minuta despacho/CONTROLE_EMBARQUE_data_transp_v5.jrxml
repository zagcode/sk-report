				<textFieldExpression class="java.lang.String"><![CDATA[new SimpleDateFormat("dd/MM/yyyy HH:mm").format($P{DTNEG.INI}) + " até " + new SimpleDateFormat("dd/MM/yyyy HH:mm").format($P{DTNEG.FIN})]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="6" y="77" width="543" height="20"/>
