					<font isBold="true"/>
				</textElement>
				<text><![CDATA[MINUTA DE DESPACHO]]></text>
			</staticText>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-87" x="151" y="16" width="394" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Courier New" size="8" pdfFontName="Courier"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{TIPOEND} + " " + $F{NOMEENDERECOEMP} + " N." + $F{NUMEROENDEMP} +
"\nBAIRRO " + $F{EMPBAI} + ", " + ($F{EMPCID} !=null ? $F{EMPCID}.trim() : "") + "-" + $F{EMPUF} +
"\n" + "FONE:" + $F{TELEFONEEMP}+ " CEP:" + $F{CEPEMP}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
