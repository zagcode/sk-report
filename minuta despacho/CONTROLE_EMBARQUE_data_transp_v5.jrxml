<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CONTROLEMBARQUE" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false"/>
	<parameter name="P_NUMEMB" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DTNEG.INI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data Inicial]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DTNEG.FIN" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data Final]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CODPARCTRANSP" class="java.lang.String">
		<property name="PESQUISA" value="TRUE"/>
		<property name="NOMETABELA" value="TGFPAR"/>
		<parameterDescription><![CDATA[Transportadora]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_CODEMP" class="java.math.BigDecimal">
		<property name="PESQUISA" value="TRUE"/>
		<property name="NOMETABELA" value="TSIEMP"/>
		<parameterDescription><![CDATA[Empresa]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT CAB.NUNOTA
, CAB.DTNEG
, CAB.NUMNOTA
, CAB.OBSERVACAO
, CAB.CODEMP
, EMP.RAZAOSOCIAL AS RAZAOEMP

,    BAI1.NOMEBAI AS EMPBAI
,    TRIM(UPPER(CID1.NOMECID)) AS EMPCID
,    TRIM(UFS1.UF) AS EMPUF
,    FORMAT(CAST(EMP.CGC AS BIGINT), '00-000-000/0000-00') AS CGCEMP
,    EMP.INSCESTAD AS INSCESTADEMP
,    TRIM(EMP.TELEFONE) AS TELEFONEEMP
,    EMP.CEP AS CEPEMP
,    UPPER(ED1.NOMEEND) AS NOMEENDERECOEMP
,    UPPER(BAI1.NOMEBAI) AS NOMEBAIRROEMP
,    EMP.NUMEND AS NUMEROENDEMP



, CAB.CODVEND
, VEN.APELIDO
, CAB.CODPARC AS CODIGO_CLIENTE
, PAR.NOMEPARC AS CLIENTE
, PAR.RAZAOSOCIAL AS RAZAOSOCIAL_CLIENTE
, PAR.TELEFONE
, PAR.FAX
, PAR.CGC_CPF
, PAR.CEP
, PAR.INSCESTADNAUF
, ENDE.NOMEEND
, ENDE.TIPO AS TIPOEND

, PAR.NUMEND
, CID.NOMECID
, UFS.DESCRICAO
, UFS.UF
, BAI.NOMEBAI
, CAB.VLRNOTA
, CAB.VLRDESCSERV
, CAB.VLRDESCTOT
, CAB.VLRDESCTOTITEM

, CAB.CODPARCTRANSP
, PAR2.NOMEPARC AS TRANSPORTADORA
, OPC.OPCAO AS CIF_FOB
, (SELECT DESCROPER FROM TGFTOP WHERE CODTIPOPER = CAB.CODTIPOPER AND DHALTER = (SELECT MAX(DHALTER) FROM TGFTOP WHERE CODTIPOPER = CAB.CODTIPOPER)) AS DESCRTOP
, CAB.PESOBRUTO
, CAB.VOLUME
, CAB.QTDVOL
, FORMAT(GETDATE(),'dd/MM/yyyy HH:mm:ss') AS DATAEHORAATUAL

FROM TGFCAB CAB
JOIN TGFPAR PAR ON CAB.CODPARC = PAR.CODPARC
JOIN TGFPAR PAR2 ON PAR2.CODPARC = CAB.CODPARCTRANSP
JOIN TSIEND ENDE ON PAR.CODEND = ENDE.CODEND
JOIN TSIBAI BAI ON PAR.CODBAI= BAI.CODBAI
JOIN TSICID CID ON PAR.CODCID = CID.CODCID
JOIN TSIUFS UFS ON CID.UF = UFS.CODUF
JOIN TGFVEI VEI ON CAB.CODVEICULO = VEI.CODVEICULO
JOIN TSIEMP EMP ON CAB.CODEMP = EMP.CODEMP
JOIN TSIEND ED1 ON (EMP.CODEND = ED1.CODEND)
JOIN TSIBAI BAI1 ON (EMP.CODBAI = BAI1.CODBAI)
JOIN TSICID CID1 ON (EMP.CODCID = CID1.CODCID)
JOIN TSIUFS UFS1 ON (CID1.UF = UFS1.CODUF)
JOIN TGFVEN VEN ON VEN.CODVEND = CAB.CODVEND
JOIN TDDOPC OPC ON CAB.CIF_FOB = OPC.VALOR AND OPC.NUCAMPO = 765

WHERE
CAB.TIPMOV ='V'
AND CAB.DTFATUR BETWEEN FORMAT($P{DTNEG.INI},'dd/MM/yyyy HH:mm') AND FORMAT($P{DTNEG.FIN},'dd/MM/yyyy HH:mm')
AND CAB.CODPARCTRANSP = $P{CODPARCTRANSP}
AND ($P{P_CODEMP} IS NULL OR CAB.CODEMP = $P{P_CODEMP})

ORDER BY CAB.DTNEG, CAB.NUNOTA, CAB.CODEMP]]>
	</queryString>
	<field name="NUNOTA" class="java.lang.Integer"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="NUMNOTA" class="java.lang.Integer"/>
	<field name="OBSERVACAO" class="java.lang.String"/>
	<field name="CODEMP" class="java.lang.Short"/>
	<field name="RAZAOEMP" class="java.lang.String"/>
	<field name="EMPBAI" class="java.lang.String"/>
	<field name="EMPCID" class="java.lang.String"/>
	<field name="EMPUF" class="java.lang.String"/>
	<field name="CGCEMP" class="java.lang.String"/>
	<field name="INSCESTADEMP" class="java.lang.String"/>
	<field name="TELEFONEEMP" class="java.lang.String"/>
	<field name="CEPEMP" class="java.lang.String"/>
	<field name="NOMEENDERECOEMP" class="java.lang.String"/>
	<field name="NOMEBAIRROEMP" class="java.lang.String"/>
	<field name="NUMEROENDEMP" class="java.lang.String"/>
	<field name="CODVEND" class="java.lang.Short"/>
	<field name="APELIDO" class="java.lang.String"/>
	<field name="CODIGO_CLIENTE" class="java.lang.Integer"/>
	<field name="CLIENTE" class="java.lang.String"/>
	<field name="RAZAOSOCIAL_CLIENTE" class="java.lang.String"/>
	<field name="TELEFONE" class="java.lang.String"/>
	<field name="FAX" class="java.lang.String"/>
	<field name="CGC_CPF" class="java.lang.String"/>
	<field name="CEP" class="java.lang.String"/>
	<field name="INSCESTADNAUF" class="java.lang.String"/>
	<field name="NOMEEND" class="java.lang.String"/>
	<field name="TIPOEND" class="java.lang.String"/>
	<field name="NUMEND" class="java.lang.String"/>
	<field name="NOMECID" class="java.lang.String"/>
	<field name="DESCRICAO" class="java.lang.String"/>
	<field name="UF" class="java.lang.String"/>
	<field name="NOMEBAI" class="java.lang.String"/>
	<field name="VLRNOTA" class="java.math.BigDecimal"/>
	<field name="VLRDESCSERV" class="java.lang.Double"/>
	<field name="VLRDESCTOT" class="java.lang.Double"/>
	<field name="VLRDESCTOTITEM" class="java.lang.Double"/>
	<field name="CODPARCTRANSP" class="java.lang.Integer"/>
	<field name="TRANSPORTADORA" class="java.lang.String"/>
	<field name="CIF_FOB" class="java.lang.String"/>
	<field name="DESCRTOP" class="java.lang.String"/>
	<field name="PESOBRUTO" class="java.math.BigDecimal"/>
	<field name="VOLUME" class="java.lang.String"/>
	<field name="QTDVOL" class="java.math.BigDecimal"/>
	<field name="DATAEHORAATUAL" class="java.lang.String"/>
	<variable name="TotalPeso" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOBRUTO}]]></variableExpression>
	</variable>
	<variable name="TotalValor" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRNOTA}]]></variableExpression>
	</variable>
	<variable name="TotalVol" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{QTDVOL}]]></variableExpression>
	</variable>
	<title>
		<band height="120" splitType="Stretch">
			<rectangle radius="10">
				<reportElement x="-1" y="52" width="325" height="20" backcolor="#CCCCCC"/>
			</rectangle>
			<textField>
				<reportElement x="151" y="2" width="394" height="14"/>
				<textElement textAlignment="Center" markup="none">
					<font fontName="Arial" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{RAZAOEMP}]]></textFieldExpression>
			</textField>
