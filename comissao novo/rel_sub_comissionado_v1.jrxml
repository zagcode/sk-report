	<property name="ireport.zoom" value="1.7715610000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="DATA_NEG_INI" class="java.sql.Timestamp">
		<property name="TGFCAB" value="DTNEG"/>
		<parameterDescription><![CDATA[DT. de Negociação(inicio)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_NEG_FIN" class="java.sql.Timestamp">
		<property name="TGFCAB" value="DTNEG"/>
		<parameterDescription><![CDATA[Dt. de Negociação(final)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CODEMP" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="CODVEND" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[-- Primeira consulta (vendedor principal)
SELECT
    PAR.CODPARC,
    PAR.NOMEPARC,
    UPPER(CID.NOMECID) AS NOMECID,
    SUM(COM.VLRTOTAL) AS VALORNOTA,
    SUM(COM.VLRCOM_REP) AS VALORCOMISSAO
FROM AD_COMISSAODPS COM
INNER JOIN TGFPAR PAR ON PAR.CODPARC = COM.CODPARC
LEFT JOIN TSICID CID ON CID.CODCID = PAR.CODCID
WHERE COM.DTNEG BETWEEN $P{DATA_NEG_INI} AND $P{DATA_NEG_FIN}
    AND COM.CODEMP = $P{CODEMP}
    -- Se vendedor informado, filtra por ele; senão, filtra por tipo_classe
    AND COM.CODVEND = $P{CODVEND}
GROUP BY
    PAR.CODPARC,
    PAR.NOMEPARC,
    CID.NOMECID

UNION ALL

-- Segunda consulta (vendedor alternativo - CODVENDATE)
SELECT
    PAR.CODPARC,
    PAR.NOMEPARC,
    UPPER(CID.NOMECID) AS NOMECID,
    SUM(COM.VLRTOTAL) AS VALORNOTA,
    SUM(COM.VLRCOM_ATE) AS VALORCOMISSAO
FROM AD_COMISSAODPS COM
INNER JOIN TGFPAR PAR ON PAR.CODPARC = COM.CODPARC
LEFT JOIN TSICID CID ON CID.CODCID = PAR.CODCID
WHERE COM.DTNEG BETWEEN $P{DATA_NEG_INI} AND $P{DATA_NEG_FIN}
    AND COM.CODEMP = $P{CODEMP}
    AND COM.CODVENDATE IS NOT NULL
    -- Se vendedor informado, filtra por ele; senão, filtra por tipo_classe
    AND COM.CODVENDATE = $P{CODVEND}
GROUP BY
    PAR.CODPARC,
    PAR.NOMEPARC,
    CID.NOMECID

ORDER BY CODPARC]]>
	</queryString>
	<field name="CODPARC" class="java.lang.Integer"/>
	<field name="NOMEPARC" class="java.lang.String"/>
	<field name="NOMECID" class="java.lang.String"/>
	<field name="VALORNOTA" class="java.math.BigDecimal"/>
	<field name="VALORCOMISSAO" class="java.math.BigDecimal"/>
