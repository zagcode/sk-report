<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Faturamento_credito" language="groovy" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.143588810000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="CODPARC" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="DTINI" class="java.sql.Timestamp" isForPrompting="false"/>
	<parameter name="DTFIN" class="java.sql.Timestamp" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT DEV.NUMNOTA, CAB.NUMNOTA AS NF, CAB.DTNEG, SUM(DISTINCT FIN_CRED.VLRDESDOB) AS VALOR
FROM TGFFIN FIN
INNER JOIN TGFCAB CAB ON (CAB.NUNOTA = FIN.NUNOTA)
INNER JOIN TGFFIN FIN_COMP ON (FIN_COMP.NUNOTA = FIN.NUNOTA)
INNER JOIN TGFFIN FIN_CRED ON (FIN_CRED.NUCOMPENS = FIN_COMP.NUCOMPENS AND FIN_COMP.VLRDESDOB = FIN_CRED.VLRDESDOB)
INNER JOIN TGFCAB DEV ON (DEV.NUNOTA = FIN_CRED.NUNOTA)
WHERE CAB.CODPARC = $P{CODPARC}
AND CAB.DTNEG BETWEEN $P{DTINI} AND $P{DTFIN}
AND FIN_COMP.NUFIN <> FIN_CRED.NUFIN
AND FIN_COMP.NUCOMPENS IS NOT NULL
AND DEV.TIPMOV = 'D'
GROUP BY DEV.NUMNOTA, CAB.NUMNOTA, CAB.DTNEG
ORDER BY CAB.NUMNOTA]]>
	</queryString>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="NF" class="java.math.BigDecimal"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<variable name="VLRNOTATOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALOR}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="Count">
		<variableExpression><![CDATA[java.math.BigDecimal.ONE]]></variableExpression>
	</variable>
	<columnHeader>
		<band height="35">
			<staticText>
				<reportElement x="180" y="0" width="176" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[CRÉDITO]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="20" width="60" height="15"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Número]]></text>
			</staticText>
			<staticText>
				<reportElement x="89" y="20" width="50" height="15"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[NF]]></text>
			</staticText>
			<staticText>
				<reportElement x="180" y="20" width="68" height="15"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Emissão]]></text>
			</staticText>
			<staticText>
				<reportElement x="296" y="20" width="100" height="15"/>
				<textElement textAlignment="Right">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Valor]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="34" width="555" height="1"/>
			</line>
		</band>
	</columnHeader>
	<detail>
		<band height="15" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="60" height="15"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{NUMNOTA}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="89" y="0" width="50" height="15"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{NF}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="180" y="0" width="100" height="15"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.sql.Timestamp"><![CDATA[$F{DTNEG}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="296" y="0" width="100" height="15"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{VALOR}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band height="17" splitType="Stretch">
			<staticText>
				<reportElement x="207" y="2" width="89" height="15"/>
				<textElement textAlignment="Right">
					<font size="9"/>
				</textElement>
				<text><![CDATA[Valor Total:]]></text>
			</staticText>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="296" y="2" width="100" height="15"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{VLRNOTATOTAL}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="2" width="60" height="15"/>
				<textElement/>
				<text><![CDATA[Total Notas:]]></text>
			</staticText>
			<textField>
				<reportElement x="60" y="2" width="81" height="15"/>
				<textElement/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{QTDNOTAS}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="0" width="555" height="1"/>
			</line>
		</band>
	</columnFooter>
</jasperReport>
