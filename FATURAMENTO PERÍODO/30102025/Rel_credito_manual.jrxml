<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Faturamento_credito_manual" language="groovy" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.3310000000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="CODPARC" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="DTINI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data Inicio]]></parameterDescription>
	</parameter>
	<parameter name="DTFIN" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data Fim]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[WITH BaseData AS (
SELECT
B.NUMNOTA AS NF_DEVOLUCAO,
CAB.NUMNOTA AS NOTA,
B.VLRDESDOB AS VALOR,
CAB_DEV.VLRNOTA AS VLR,
F.NUDEV
FROM TGFFIN F
INNER JOIN TGFFIN B ON B.NUDEV = F.NUDEV AND B.RECDESP = -1 AND B.DHBAIXA is not null
INNER JOIN TGFCAB CAB on F.NUMNOTA = CAB.NUMNOTA
INNER JOIN TGFCAB CAB_DEV on B.NUMNOTA = CAB_DEV.NUMNOTA
WHERE F.CODPARC = $P{CODPARC}
AND (F.DTNEG >= $P{DTINI} AND F.DTNEG <= $P{DTFIN})
GROUP BY CAB.NUMNOTA, B.NUMNOTA, F.NUDEV, B.VLRDESDOB, CAB_DEV.VLRNOTA
)
SELECT
    b.NOTA,
    b.VLR,
    b.NF_DEVOLUCAO,
    SUM(b.VALOR) as VLR_SOMADO
FROM BaseData b
INNER JOIN TGFCAB CAB on NOTA = CAB.NUMNOTA
WHERE CAB.NUNOTA IN (
  SELECT NUNOTA
  FROM TGFFIN FIN
  WHERE
  FIN.CODPARC = $P{CODPARC}
  AND (FIN.DTNEG >= $P{DTINI} AND FIN.DTNEG <= $P{DTFIN})
  AND CAB.SERIENOTA IS NOT NULL
  AND CAB.TIPMOV <> 'D'
  AND CAB.STATUSNFE = 'A'
  AND FIN.CODTIPTIT <> 4
)
GROUP BY b.NOTA,b.VLR, b.NF_DEVOLUCAO]]>
	</queryString>
	<field name="NOTA" class="java.math.BigDecimal"/>
	<field name="NF_DEVOLUCAO" class="java.math.BigDecimal"/>
	<field name="VLR" class="java.math.BigDecimal"/>
	<field name="VLR_SOMADO" class="java.math.BigDecimal"/>
	<variable name="VLRNOTAABAT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLR_SOMADO}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{NF_DEVOLUCAO}]]></variableExpression>
	</variable>
	<variable name="VLRTOTAL" class="java.math.BigDecimal" calculation="Sum"/>
	<columnHeader>
