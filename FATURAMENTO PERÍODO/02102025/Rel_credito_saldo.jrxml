<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Faturamento_credito_saldo" language="groovy" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.7715610000000022"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="CODPARC" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="DTINI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data Inicio]]></parameterDescription>
	</parameter>
	<parameter name="DTFIN" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data Fim]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT
   DEV.NUMNOTA as NF_DEVOLUCAO,
    DEV.VLRNOTA AS TOTAL,
    SUM(
        (ISNULL(FIN.VLRDESDOB,0) +
        ISNULL(FIN.DESPCART,0) +
        ISNULL(FIN.VLRVENDOR,0) -
        ISNULL(FIN.VLRDESC,0) -
        ISNULL(FIN.CARTAODESC,0) +
        ISNULL(FIN.VLRMULTANEGOC,0) +
        ISNULL(FIN.VLRJURONEGOC,0) -
        ISNULL(FIN.VLRMULTALIB,0) -
        ISNULL(FIN.VLRJUROLIB,0) +
        ISNULL(FIN.VLRVARCAMBIAL,0)
        )) AS VLRCREDITO
FROM TGFFIN FIN
LEFT JOIN TGFCAB DEV
      ON DEV.NUNOTA = FIN.NUNOTA
      AND DEV.TIPMOV = 'D'
WHERE
   (FIN.RECDESP = -1)
   AND (FIN.DHBAIXA IS NULL)
   AND FIN.PROVISAO = 'N'
   AND FIN.CODTIPTIT = 20
   AND  FIN.CODPARC = $P{CODPARC}
   AND  FIN.DTNEG BETWEEN $P{DTINI} AND $P{DTFIN}
GROUP BY DEV.NUMNOTA,DEV.VLRNOTA]]>
	</queryString>
	<field name="NF_DEVOLUCAO" class="java.math.BigDecimal"/>
	<field name="VLRCREDITO" class="java.math.BigDecimal"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<variable name="TotalSaldo" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRCREDITO}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{NF_DEVOLUCAO}]]></variableExpression>
	</variable>
	<variable name="VLRTOTAL" class="java.math.BigDecimal" calculation="Sum"/>
	<columnHeader>
		<band height="35">
			<staticText>
				<reportElement x="180" y="0" width="176" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[CRÉDITOS PENDENTES]]></text>
			</staticText>
			<staticText>
				<reportElement x="141" y="20" width="84" height="15"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Valor NF Dev]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="20" width="105" height="15"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[NF Devolução]]></text>
			</staticText>
			<staticText>
				<reportElement x="281" y="19" width="100" height="15"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Valor Utilizado]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="34" width="555" height="1"/>
			</line>
			<staticText>
				<reportElement x="444" y="20" width="100" height="15"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Saldo]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="15" splitType="Stretch">
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement x="141" y="0" width="71" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TOTAL}]]></textFieldExpression>
			</textField>
			<textField pattern="" isBlankWhenNull="false">
				<reportElement x="0" y="0" width="105" height="15"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{NF_DEVOLUCAO}]]></textFieldExpression>
			</textField>
			<textField pattern="" isBlankWhenNull="false">
				<reportElement x="281" y="0" width="100" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{TOTAL}.compareTo( $F{VLRCREDITO} ) == 0 ? "-" : new java.text.DecimalFormat("#,##0.00").format(($F{TOTAL}.subtract($F{VLRCREDITO})))]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="false">
				<reportElement x="444" y="0" width="100" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{VLRCREDITO}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
