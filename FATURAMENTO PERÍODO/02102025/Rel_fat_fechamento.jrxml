					<font isBold="true" isItalic="false"/>
				</textElement>
				<text><![CDATA[Qtde de Notas:]]></text>
			</staticText>
			<textField>
				<reportElement x="86" y="6" width="42" height="15"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{QTDNOTAS}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="128" y="6" width="73" height="15"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Valor NF: ]]></text>
			</staticText>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="201" y="6" width="58" height="15"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{VLRNOTATOTAL}]]></textFieldExpression>
			</textField>
			<staticText>
