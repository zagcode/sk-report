<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Faturamento_fechamento" language="groovy" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="3.797498335832415"/>
	<property name="ireport.x" value="258"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="CODPARC" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="DTINI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data Inicio]]></parameterDescription>
	</parameter>
	<parameter name="DTFIN" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data Fim]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT
  CAB.NUMNOTA,
  CAB.SERIENOTA,
  CAB.DTNEG,
  CAB.VLRNOTA,
  CAB.NUNOTA,
  DEV_INFO.NF_DEVOLUCAO,
  (
    SELECT SUM(fin.vlrdesdob)
    FROM tgffin fin
    WHERE fin.nunota = CAB.NUNOTA
    AND fin.codparc = CAB.CODPARC
    AND fin.dhbaixa is not null
  ) AS VALOR_DEVOLVIDO
FROM TGFCAB CAB
LEFT JOIN (
    SELECT
      FIN_COMP.NUNOTA,
     STRING_AGG(DEV.NUMNOTA, ' / ') AS NF_DEVOLUCAO
    FROM TGFFIN FIN_COMP
    LEFT JOIN TGFFIN FIN_CRED
      ON (FIN_CRED.NUCOMPENS = FIN_COMP.NUCOMPENS or FIN_CRED.NUCOMPENS is null)
     AND FIN_COMP.VLRDESDOB = FIN_CRED.VLRDESDOB
     AND FIN_COMP.NUFIN <> FIN_CRED.NUFIN
     AND FIN_CRED.CODTIPTIT = 20
    LEFT JOIN TGFCAB DEV
      ON DEV.NUNOTA = FIN_CRED.NUNOTA
     AND DEV.TIPMOV = 'D'
    GROUP BY FIN_COMP.NUNOTA
) DEV_INFO ON DEV_INFO.NUNOTA = CAB.NUNOTA
WHERE CAB.NUNOTA IN (
  SELECT NUNOTA
  FROM TGFFIN FIN
  WHERE
  FIN.CODPARC = $P{CODPARC}
  AND FIN.DTNEG BETWEEN $P{DTINI} AND $P{DTFIN}
  AND CAB.SERIENOTA IS NOT NULL
  AND CAB.TIPMOV <> 'D'
  AND CAB.STATUSNFE = 'A'
  AND FIN.CODTIPTIT <> 4
)]]>
	</queryString>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="SERIENOTA" class="java.lang.String"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="VLRNOTA" class="java.math.BigDecimal"/>
	<field name="NUNOTA" class="java.math.BigDecimal"/>
	<field name="VALOR_DEVOLVIDO" class="java.math.BigDecimal"/>
	<variable name="VLRNOTATOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRNOTA}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="Count">
		<variableExpression><![CDATA[java.math.BigDecimal.ONE]]></variableExpression>
	</variable>
	<variable name="VLRTOTALABATIDO" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALOR_DEVOLVIDO} == null ? java.math.BigDecimal.ZERO : $F{VALOR_DEVOLVIDO}]]></variableExpression>
	</variable>
	<variable name="VALOR_DEVOLVIDO_TEXTO" class="java.lang.String">
		<variableExpression><![CDATA[$F{VALOR_DEVOLVIDO} == null ? "-" : new java.text.DecimalFormat("#,##0.00").format($F{VALOR_DEVOLVIDO})]]></variableExpression>
	</variable>
	<variable name="VALOR_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRNOTA}.subtract($F{VALOR_DEVOLVIDO} == null ? BigDecimal.ZERO : $F{VALOR_DEVOLVIDO})]]></variableExpression>
	</variable>
	<columnHeader>
		<band height="36">
			<staticText>
				<reportElement x="1" y="0" width="554" height="20"/>
