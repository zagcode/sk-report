			</staticText>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement x="281" y="0" width="100" height="15"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="2" width="60" height="15"/>
				<textElement/>
				<text><![CDATA[Qtde Notas:]]></text>
			</staticText>
			<textField>
				<reportElement x="60" y="2" width="81" height="15"/>
				<textElement/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{QTDNOTAS}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="0" width="555" height="1"/>
			</line>
			<staticText>
				<reportElement x="396" y="0" width="93" height="15"/>
				<textElement textAlignment="Center">
					<font size="10"/>
				</textElement>
				<text><![CDATA[Total Abatimento:]]></text>
			</staticText>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement x="490" y="0" width="65" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{VLRNOTAABAT}]]></textFieldExpression>
			</textField>
		</band>
	</columnFooter>
</jasperReport>
