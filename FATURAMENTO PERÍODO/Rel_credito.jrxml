<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Faturamento_credito" language="groovy" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.7715610000000017"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="CODPARC" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="DTINI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data Inicio]]></parameterDescription>
	</parameter>
	<parameter name="DTFIN" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data Fim]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[WITH OcorrenciaBASE AS (
    SELECT
        FIN_CRED.NUMNOTA as FIN_CRED_NUMNOTA,
        COUNT(DISTINCT DEV.NUMNOTA) as OCORRENCIAS
    FROM TGFFIN FIN_COMP
    JOIN TGFFIN FIN_CRED
      ON FIN_CRED.NUCOMPENS = FIN_COMP.NUCOMPENS
     AND FIN_COMP.VLRDESDOB = FIN_CRED.VLRDESDOB
     AND FIN_COMP.NUFIN <> FIN_CRED.NUFIN
    -- AND FIN_CRED.CODTIPTIT = 31
     AND FIN_CRED.RECDESP = 1
    LEFT JOIN TGFCAB DEV
      ON DEV.NUNOTA = FIN_COMP.NUNOTA
      AND DEV.TIPMOV = 'D'
    WHERE
        FIN_COMP.codparc = $P{CODPARC}
        AND FIN_COMP.DTNEG BETWEEN $P{DTINI} AND $P{DTFIN}
        and DEV.NUMNOTA is not null
    GROUP BY FIN_CRED.NUMNOTA
),
BaseData AS (
SELECT
     DEV.NUMNOTA as NF_DEVOLUCAO,
     DEV.VLRNOTA AS TOTAL,
     FIN_COMP.NUNOTA,
     FIN_CRED.NUMNOTA as FIN_CRED_NUMNOTA,
     FIN_CRED.NUFIN,
     FIN_CRED.VLRDESDOB as VALOR,
     ROW_NUMBER() OVER(PARTITION BY FIN_CRED.NUFIN ORDER BY (SELECT NULL)) as rn
    FROM TGFFIN FIN_COMP
    JOIN TGFFIN FIN_CRED
      ON FIN_CRED.NUCOMPENS = FIN_COMP.NUCOMPENS
     AND FIN_COMP.VLRDESDOB = FIN_CRED.VLRDESDOB
     AND FIN_COMP.NUFIN <> FIN_CRED.NUFIN
     --AND FIN_CRED.CODTIPTIT = 31
     AND FIN_CRED.RECDESP = 1
    LEFT JOIN TGFCAB DEV
      ON DEV.NUNOTA = FIN_COMP.NUNOTA
      AND DEV.TIPMOV = 'D'
where
FIN_COMP.codparc = $P{CODPARC}
AND FIN_COMP.DTNEG BETWEEN $P{DTINI} AND $P{DTFIN}
and DEV.NUMNOTA is not null
GROUP BY DEV.VLRNOTA,FIN_COMP.NUNOTA, FIN_CRED.NUMNOTA, DEV.NUMNOTA,FIN_CRED.NUFIN, FIN_CRED.VLRDESDOB
)
SELECT
    bd.NF_DEVOLUCAO,
    bd.TOTAL,
    bd.FIN_CRED_NUMNOTA,
    SUM(bd.VALOR) as VALOR_SOMADO,
    CASE WHEN oc.OCORRENCIAS > 1 THEN 'Parcial' ELSE 'Integral' END AS TIPO_ABATIMENTO
FROM BaseData bd
JOIN OcorrenciaBASE oc ON bd.FIN_CRED_NUMNOTA = oc.FIN_CRED_NUMNOTA
WHERE bd.rn = 1
GROUP BY
    bd.NF_DEVOLUCAO,
    bd.TOTAL,
    bd.FIN_CRED_NUMNOTA,
    oc.OCORRENCIAS
ORDER BY
    bd.NF_DEVOLUCAO]]>
	</queryString>
	<field name="NF_DEVOLUCAO" class="java.math.BigDecimal"/>
	<field name="VALOR_SOMADO" class="java.math.BigDecimal"/>
	<field name="FIN_CRED_NUMNOTA" class="java.math.BigDecimal"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<field name="TIPO_ABATIMENTO" class="java.lang.String"/>
	<variable name="VLRNOTAABAT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALOR_SOMADO}]]></variableExpression>
	</variable>
	<variable name="QTDNOTAS" class="java.math.BigDecimal" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{NF_DEVOLUCAO}]]></variableExpression>
	</variable>
	<variable name="VLRTOTAL" class="java.math.BigDecimal" calculation="Sum"/>
	<columnHeader>
